# Which exchange kit this instance runs on.
EXCHANGE=binance

# ── LLM layer ───────────────────────────────────────────────────────────
# Venice powers narrative synthesis + web research; the Claude API is the
# fallback brain and researcher when Venice is unfunded or unavailable.
# At least one of these must be set.
VENICE_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ── Binance Agent OS ────────────────────────────────────────────────────
# Optional. The Binance MCP Server only accepts its allowlisted agent clients,
# so a deployment normally has no session of its own — the caller passes their
# own MCP tool output into optic_read instead. These exist for the day Binance
# opens client registration.
# BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
# BINANCE_OAUTH_CLIENT_METADATA_URL=https://<your-domain>/.well-known/oauth-client.json
# BINANCE_MCP_TOOL_MAP=

# Guards the one-time "connect this deployment" route.
ADMIN_TOKEN=

# ── B402 (Binance x402) — needs merchant onboarding ─────────────────────
PAYMENTS_ENFORCED=false
# B402_API_KEY=
# B402_BASE_URL=
# PAYOUT_ADDRESS_BSC=

# ── Service ─────────────────────────────────────────────────────────────
PRICE_USDT=0.5
READ_BUDGET_USD=0.5
CACHE_TTL_SECONDS=600
DATABASE_PATH=./data/optic.db
CARDS_DIR=./data/cards
SITE_DIR=./site-binance
PUBLIC_BASE_URL=http://localhost:3000
