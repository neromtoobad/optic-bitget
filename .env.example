# This edition runs on Bitget.
EXCHANGE=bitget

# ── LLM layer ───────────────────────────────────────────────────────────
# The debate and judge run on Bitget's hackathon Qwen gateway (OpenAI-compatible).
# Venice and the Claude API are fallbacks. With no key at all the desk still
# returns the computed legs and the archive's base rate, with no verdict.
OPENAI_COMPAT_BASE_URL=https://hackathon.bitgetops.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=qwen3.8-max
# VENICE_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ── Bitget ──────────────────────────────────────────────────────────────
# Market data (USDT-FUTURES, where rToken US stocks trade as perpetuals) is
# public — no key needed for the desk's reads. The optional key below is for
# account-scoped reads through Agent Hub and must be READ-ONLY: this is a
# research desk, the trader places the order.
# BITGET_REST_BASE=https://api.bitget.com
# BITGET_API_KEY=
# BITGET_SECRET_KEY=
# BITGET_PASSPHRASE=

# ── Payments (off) ──────────────────────────────────────────────────────
PAYMENTS_ENFORCED=false

# ── Service ─────────────────────────────────────────────────────────────
PRICE_USDT=0.5
READ_BUDGET_USD=0.5
CACHE_TTL_SECONDS=600
DATABASE_PATH=./data/optic.db
CARDS_DIR=./data/cards
HISTORY_DIR=./data/history
SITE_DIR=./site-bitget
PUBLIC_BASE_URL=http://localhost:3000
